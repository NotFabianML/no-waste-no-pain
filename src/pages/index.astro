---
import '../styles/global.css';
const categories = [
  ['University','amount',420,'sky'],['Home & essentials','amount',180,'lavender'],['Fun money','percent',8,'peach'],['Subscriptions','amount',34,'mint']
];
---
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>No Waste No Pain</title></head><body><main class="shell">
<header class="topbar"><a class="brand" href="/"><span class="mark">NW<br/>NP</span><span>No Waste<br/><i>No Pain</i></span></a></header>
<section class="intro"><h1>Make room<br/><em>for what matters.</em></h1></section>
<section class="period-card glass"><div class="section-label"><span>01</span><span>Set your period</span></div><div class="period-grid"><label>Period<select id="period"><option>Monthly</option><option selected>Bi-weekly</option><option>Weekly</option></select></label><label>First paycheck<select id="start"><option>15th</option><option>1st</option></select></label><label>Second paycheck<select id="end"><option>30th</option><option>15th</option></select></label></div><div class="income-row"><label>Total take-home income<input id="income" type="number" value="1800" min="0"/></label><span class="currency">USD</span></div><div class="period-budget"><label>Budget for <span id="budget-period">Bi-weekly</span><input id="period-budget" type="number" value="900" min="0"/></label><span class="currency">USD</span></div></section>
<section class="budget-section"><div class="section-label"><span>02</span><span>Give every dollar a place</span><button id="add" class="add-button">+ Add a line</button></div><div id="categories" class="category-list">{categories.map(([name,mode,value,tint])=><div class={`category-row ${tint}`} data-mode={mode}><span class="dot"></span><input class="category-name" value={name} aria-label="Category name"/><div class="value-wrap"><input class="category-value" type="number" value={value} min="0" aria-label="Budget value"/><button class="mode-toggle" aria-label="Toggle amount or percentage">{mode==='amount'?'$':'%'}</button></div><button class="remove" aria-label="Remove category">×</button></div>)}</div></section>
<section class="summary glass"><div><p class="kicker">Still to place</p><strong id="leftover">$1,038</strong><p id="summary-copy">58% of your income is still flexible.</p></div><div class="ring"><span id="used">42%</span><small>planned</small></div></section><button class="copy-button" id="copy">Copy as markdown <span>↗</span></button><p class="footnote" id="status">Saved locally in this browser.</p>
</main><script>
const income=document.querySelector('#income'),period=document.querySelector('#period'),periodBudget=document.querySelector('#period-budget'),list=document.querySelector('#categories'),left=document.querySelector('#leftover'),used=document.querySelector('#used'),status=document.querySelector('#status'); const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n); const budgets={Monthly:1800,'Bi-weekly':900,Weekly:450};
function calc(){const total=Number(periodBudget.value)||0;let planned=0;list.querySelectorAll('.category-row').forEach(r=>{const v=Number(r.querySelector('.category-value').value)||0;const isPercent=r.dataset.mode==='percent';const valueWrap=r.querySelector('.value-wrap');let equivalent=r.querySelector('.equivalent');if(!equivalent){equivalent=document.createElement('span');equivalent.className='equivalent';valueWrap.insertBefore(equivalent,r.querySelector('.mode-toggle'))}planned+=isPercent?total*v/100:v;equivalent.textContent=isPercent?money(total*v/100):''});const p=total?Math.round(planned/total*100):0;left.textContent=money(total-planned);used.textContent=p+'%';document.querySelector('#summary-copy').textContent=`${Math.max(0,100-p)}% of this period budget is still flexible.`;document.querySelector('.ring').style.setProperty('--progress',p+'%')} list.addEventListener('input',calc);income.addEventListener('input',calc);periodBudget.addEventListener('input',calc);period.onchange=()=>{document.querySelector('#budget-period').textContent=period.value;if(!periodBudget.dataset.edited)periodBudget.value=budgets[period.value]||0;calc()};periodBudget.oninput=()=>{periodBudget.dataset.edited='true';calc()};
list.addEventListener('click',e=>{if(e.target.classList.contains('remove')){e.target.closest('.category-row').remove();calc()}if(e.target.classList.contains('mode-toggle')){const r=e.target.closest('.category-row');r.dataset.mode=r.dataset.mode==='amount'?'percent':'amount';e.target.textContent=r.dataset.mode==='amount'?'$':'%';e.target.setAttribute('aria-label',`Switch to ${r.dataset.mode==='amount'?'percentage':'amount'} mode`);calc()}});
document.querySelector('#add').onclick=()=>{const r=document.createElement('div');r.className='category-row sky';r.dataset.mode='amount';r.innerHTML='<span class="dot"></span><input class="category-name" value="New category" aria-label="Category name"/><div class="value-wrap"><input class="category-value" type="number" value="0" min="0" aria-label="Budget value"/><span class="equivalent"></span><button class="mode-toggle" aria-label="Switch to percentage mode">$</button></div><button class="remove" aria-label="Remove category">×</button>';list.append(r);calc()};
document.querySelector('#copy').onclick=async()=>{let md=`# My No Waste No Pain plan\n\n**${document.querySelector('#period').value}** · ${document.querySelector('#start').value} → ${document.querySelector('#end').value}\n\nIncome: **${money(Number(income.value)||0)}**\n\n`;list.querySelectorAll('.category-row').forEach(r=>md+=`- ${r.querySelector('.category-name').value}: ${r.dataset.mode==='percent'?r.querySelector('.category-value').value+'%':money(Number(r.querySelector('.category-value').value)||0)}\n`);md+=`\nLeftover: **${left.textContent}**`;await navigator.clipboard.writeText(md);status.textContent='Copied. Ready for your notes app.';setTimeout(()=>status.textContent='Your plan stays in this browser.',2200)};calc();
</script></body></html>
