---
import '../styles/global.css';
const categories = [
  ['University','amount',420,'sky'],['Home & essentials','amount',180,'lavender'],['Fun money','percent',8,'peach'],['Subscriptions','amount',34,'mint']
];
---
<html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>No Waste No Pain</title></head><body><main class="shell">
<header class="topbar"><a class="brand" href="/"><span class="mark">NW<br/>NP</span><span>No Waste<br/><i>No Pain</i></span></a><button class="icon-button" aria-label="Toggle theme">☼</button></header>
<section class="intro"><p class="kicker">Your money, in plain sight</p><h1>A little less guesswork.<br/><em>A lot more ease.</em></h1><p class="lede">Plan your next stretch of spending without making it a whole thing.</p></section>
<section class="period-card glass"><div class="section-label"><span>01</span><span>Set your period</span></div><div class="period-grid"><label>Period<select id="period"><option>Monthly</option><option>Bi-weekly</option><option>Weekly</option><option>Custom</option></select></label><label>Starts<input id="start" type="date" value="2026-09-01"/></label><label>Ends<input id="end" type="date" value="2026-09-30"/></label></div><div class="income-row"><label>Your take-home income<input id="income" type="number" value="1800" min="0"/></label><span class="currency">USD</span></div></section>
<section class="budget-section"><div class="section-label"><span>02</span><span>Give every dollar a place</span><button id="add" class="add-button">+ Add a line</button></div><div id="categories" class="category-list">{categories.map(([name,mode,value,tint])=><div class={`category-row ${tint}`} data-mode={mode}><span class="dot"></span><input class="category-name" value={name} aria-label="Category name"/><div class="value-wrap"><input class="category-value" type="number" value={value} min="0" aria-label="Budget value"/><button class="mode-toggle" aria-label="Toggle amount or percentage">{mode==='amount'?'$':'%'}</button></div><button class="remove" aria-label="Remove category">×</button></div>)}</div></section>
<section class="summary glass"><div><p class="kicker">Still to place</p><strong id="leftover">$1,038</strong><p id="summary-copy">58% of your income is still flexible.</p></div><div class="ring"><span id="used">42%</span><small>planned</small></div></section><button class="copy-button" id="copy">Copy as markdown <span>↗</span></button><p class="footnote" id="status">Your plan stays in this browser.</p>
</main><script>
const income=document.querySelector('#income'),list=document.querySelector('#categories'),left=document.querySelector('#leftover'),used=document.querySelector('#used'),status=document.querySelector('#status'); const money=n=>new Intl.NumberFormat('en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(n);
function calc(){const total=Number(income.value)||0;let planned=0;list.querySelectorAll('.category-row').forEach(r=>{const v=Number(r.querySelector('.category-value').value)||0;planned+=r.dataset.mode==='percent'?total*v/100:v});const p=total?Math.round(planned/total*100):0;left.textContent=money(total-planned);used.textContent=p+'%';document.querySelector('#summary-copy').textContent=`${Math.max(0,100-p)}% of your income is still flexible.`} list.addEventListener('input',calc);income.addEventListener('input',calc);
list.addEventListener('click',e=>{if(e.target.classList.contains('remove')){e.target.closest('.category-row').remove();calc()}if(e.target.classList.contains('mode-toggle')){const r=e.target.closest('.category-row');r.dataset.mode=r.dataset.mode==='amount'?'percent':'amount';e.target.textContent=r.dataset.mode==='amount'?'$':'%';calc()}});
document.querySelector('#add').onclick=()=>{const r=document.createElement('div');r.className='category-row sky';r.dataset.mode='amount';r.innerHTML='<span class="dot"></span><input class="category-name" value="New category" aria-label="Category name"/><div class="value-wrap"><input class="category-value" type="number" value="0" min="0" aria-label="Budget value"/><button class="mode-toggle" aria-label="Toggle amount or percentage">$</button></div><button class="remove" aria-label="Remove category">×</button>';list.append(r);calc()};
document.querySelector('#copy').onclick=async()=>{let md=`# My No Waste No Pain plan\n\n**${document.querySelector('#period').value}** · ${document.querySelector('#start').value} → ${document.querySelector('#end').value}\n\nIncome: **${money(Number(income.value)||0)}**\n\n`;list.querySelectorAll('.category-row').forEach(r=>md+=`- ${r.querySelector('.category-name').value}: ${r.dataset.mode==='percent'?r.querySelector('.category-value').value+'%':money(Number(r.querySelector('.category-value').value)||0)}\n`);md+=`\nLeftover: **${left.textContent}**`;await navigator.clipboard.writeText(md);status.textContent='Copied. Ready for your notes app.';setTimeout(()=>status.textContent='Your plan stays in this browser.',2200)};calc();
</script></body></html>
