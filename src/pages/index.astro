---
import BudgetPlan from '../components/BudgetPlan.astro';
import PaySchedule from '../components/PaySchedule.astro';
import { defaultCategories, initialPlans } from '../data/budget';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#0a1118" />
    <meta name="description" content="A minimal paycheck budget planner that keeps your data in the browser." />
    <title>No Waste No Pain</title>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="No Waste No Pain home">
          <span class="mark" aria-hidden="true">NW<br />NP</span>
          <span>No Waste<br /><i>No Pain</i></span>
        </a>
      </header>

      <section class="intro">
        <h1>Make room<br /><em>for what matters.</em></h1>
      </section>

      <PaySchedule />

      <div class="plans-heading">
        <div>
          <span>02</span>
          <h2>Budget each paycheck</h2>
        </div>
        <button class="add-plan" id="add-plan" type="button">Add paycheck</button>
      </div>

      <div id="plans" class="plans">
        {initialPlans.map((title, index) => (
          <BudgetPlan title={title} categories={defaultCategories} removable={index !== 0} />
        ))}
      </div>

      <button class="copy-button" id="copy" type="button">Copy all plans as markdown</button>
      <p class="footnote" id="status">Nothing leaves this browser.</p>
    </main>

    <template id="plan-template">
      <BudgetPlan title="New paycheck" />
    </template>

    <script>
      import { initBudgetPlanner } from '../scripts/budget';
      initBudgetPlanner();
    </script>
  </body>
</html>
